{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "video:hero": "node scripts/video-hero.mjs",
    "modelo:raqueta": "npx -y @gltf-transform/cli@4 optimize modelos-fuente/raqueta.glb public/models/raqueta.glb --compress meshopt --texture-compress webp --texture-size 2048 --simplify false --join false --flatten false",
    "fotos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fotos.mjs",
    "fotos:productos": "node --env-file-if-exists=.env.local scripts/fotos-productos.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @escribe-en-base"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@playwright/test": "^1.65.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8"
  }
}
