# Las variables de green. Copiá este archivo como .env.local y completá los
# valores (en Vercel van en Settings > Environment Variables). Qué es cada una
# y de dónde sale: docs/API.md, «Variables de entorno».

# Supabase: la URL del proyecto y la clave publicable (van al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: la clave secreta (solo el servidor; saltea RLS)
SUPABASE_SECRET_KEY=

# Mercado Pago: el Access Token y el secret de la firma del webhook
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
